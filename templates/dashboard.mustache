{{!
    Dashboard of Upgrade Guard, arranged in tabs (spec Screen 1).

    Tabs: Overview (built) | Plugins | Environment | Files to move |
    Checklist | History. Switching uses Bootstrap's tab component, while the
    plugin AMD module preserves the selected pane in the URL.

    Context: tabs (id, label, active), hasscan, scan facts, state flags
    (isrunning, cronrequired, cronmessage, isfailed), overviewactions with
    the restactions that the showallactions link reveals, summary, findings,
    formhtml, canrunscan, canexport, export urls, reporturl, resultsurl,
    historyurl, the shared environment, move list, checklist and start scan
    templates, history rows, disclaimer, datasetversion, and the welcome
    text of a site without scans (welcomeheading, welcomewhat,
    welcomestartscan, welcomedata).
}}
<div class="tool-upgradeguard">

    <ul class="nav nav-tabs upgradeguard-tabs mb-3" role="tablist">
        {{#tabs}}
        <li class="nav-item" role="presentation">
            <a class="nav-link {{#active}}active{{/active}}"
               id="ug-tab-{{id}}"
               data-bs-toggle="tab"
               data-bs-target="#ug-pane-{{id}}"
               href="#ug-pane-{{id}}"
               role="tab"
               aria-controls="ug-pane-{{id}}"
               aria-selected="{{#active}}true{{/active}}{{^active}}false{{/active}}"><i class="{{icon}}" aria-hidden="true"></i>{{label}}</a>
        </li>
        {{/tabs}}
    </ul>

    <div class="tab-content">

        <div class="tab-pane fade show active" id="ug-pane-overview" role="tabpanel"
             aria-labelledby="ug-tab-overview" tabindex="0">

            {{#rulesrefresherror}}
            <div class="alert alert-warning">{{#str}}rulesrefreshfailed, tool_upgradeguard, {{rulesrefresherror}}{{/str}}</div>
            {{/rulesrefresherror}}

            {{^hasscan}}
            {{#canrunscan}}
            {{#hastargets}}
            <div class="alert alert-info">{{noscansyet}}</div>
            {{/hastargets}}
            {{/canrunscan}}

            <div class="card mb-3">
                <div class="card-body py-3">
                    <h2 class="h4">{{welcomeheading}}</h2>
                    <p class="mb-2">{{welcomewhat}}</p>
                    {{> tool_upgradeguard/startscan }}
                    <p class="text-muted small mb-0">{{welcomedata}}</p>
                </div>
            </div>
            {{^hastargets}}
            <div class="alert alert-info mb-3">
                <i class="fa fa-info-circle" aria-hidden="true"></i> {{notargetmessage}}
                <div class="small mt-2">
                    {{#ruleslastchecked}}{{#str}}ruleslastchecked, tool_upgradeguard, {{ruleslastchecked}}{{/str}}{{/ruleslastchecked}}
                    {{^ruleslastchecked}}
                        {{#str}}rulesbundledupdated, tool_upgradeguard, {{rulesupdated}}{{/str}}
                        {{#rulesfeedconfigured}}{{#str}}rulesautomaticcheck, tool_upgradeguard{{/str}}{{/rulesfeedconfigured}}
                        {{^rulesfeedconfigured}}{{#str}}rulesfeednotconfigured, tool_upgradeguard{{/str}}{{/rulesfeedconfigured}}
                    {{/ruleslastchecked}}
                </div>
            </div>
            {{/hastargets}}
            {{/hasscan}}

            {{#hasscan}}
            {{#isqueued}}
            <div class="alert alert-info mb-2">{{#str}}scanqueued, tool_upgradeguard{{/str}}</div>
            {{/isqueued}}
            {{#isrunning}}
            <div class="alert alert-info mb-2">{{#str}}scan_running, tool_upgradeguard{{/str}}</div>
            {{/isrunning}}
            {{#cronrequired}}
            <div class="alert alert-warning mb-2">{{cronmessage}}</div>
            {{/cronrequired}}
            {{#isfailed}}
            <div class="alert alert-danger mb-2">
                <strong>{{#str}}scan_failed, tool_upgradeguard{{/str}}</strong> {{errormessage}}
            </div>
            {{/isfailed}}

            <div class="card upgradeguard-summary mb-3">
                <div class="card-body py-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 upgradeguard-summary-row">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="badge upgradeguard-verdict upgradeguard-verdict-{{verdictclass}} fs-6">{{verdict}}</span>
                            <span class="text-muted text-break">
                                {{#str}}currentversion, tool_upgradeguard{{/str}}: <strong>{{currentversion}}</strong> &rarr;
                                {{#str}}targetversion, tool_upgradeguard{{/str}}: <strong>{{targetversion}}</strong>
                            </span>
                        </div>
                        {{#hasscore}}
                        <div class="d-flex flex-wrap align-items-baseline gap-2 upgradeguard-summary-score">
                            <span class="upgradeguard-score upgradeguard-score-{{verdictclass}} display-6 lh-1 fw-bold">{{score}}</span>
                            <span class="text-muted small text-nowrap">/ 100 {{#str}}readinessscore, tool_upgradeguard{{/str}}</span>
                        </div>
                        {{/hasscore}}
                    </div>
                    <div class="d-flex flex-wrap align-items-center justify-content-between border-top pt-2 mt-2 gap-2 upgradeguard-summary-row">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            {{#summary}}
                            <span class="badge bg-{{severityclass}}">{{text}}</span>
                            {{/summary}}
                        </div>
                        {{#hasscore}}
                        <div class="small text-muted text-break">
                            {{#str}}score_after_removing_unused, tool_upgradeguard{{/str}}: <strong>{{scoreafterunusedremoval}}</strong>
                        </div>
                        {{/hasscore}}
                    </div>
                </div>
            </div>

            {{^hastargets}}
            <div class="alert alert-info mb-3">
                <i class="fa fa-info-circle" aria-hidden="true"></i> {{notargetmessage}}
                <div class="small mt-2">
                    {{#ruleslastchecked}}{{#str}}ruleslastchecked, tool_upgradeguard, {{ruleslastchecked}}{{/str}}{{/ruleslastchecked}}
                    {{^ruleslastchecked}}
                        {{#str}}rulesbundledupdated, tool_upgradeguard, {{rulesupdated}}{{/str}}
                        {{#rulesfeedconfigured}}{{#str}}rulesautomaticcheck, tool_upgradeguard{{/str}}{{/rulesfeedconfigured}}
                        {{^rulesfeedconfigured}}{{#str}}rulesfeednotconfigured, tool_upgradeguard{{/str}}{{/rulesfeedconfigured}}
                    {{/ruleslastchecked}}
                </div>
            </div>
            {{/hastargets}}

            {{#hasoverviewactions}}
            <h3>{{actionsheading}}</h3>
            <div class="table-responsive">
                <table class="table table-sm generaltable mb-3">
                    <thead>
                        <tr>
                            <th scope="col">{{#str}}col_severity, tool_upgradeguard{{/str}}</th>
                            <th scope="col">{{#str}}col_action, tool_upgradeguard{{/str}}</th>
                            <th scope="col">{{#str}}col_component, tool_upgradeguard{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#overviewactions}}
                        <tr>
                            <td><span class="badge bg-{{severityclass}}">{{severity}}</span></td>
                            <td>
                                {{#hasactionurl}}<a href="{{actionurl}}">{{action}}</a>{{/hasactionurl}}
                                {{^hasactionurl}}{{action}}{{/hasactionurl}}
                            </td>
                            <td>{{components}}</td>
                        </tr>
                        {{/overviewactions}}
                    </tbody>
                    {{#hasrestactions}}
                    <tbody class="collapse" id="ug-rest-actions">
                        {{#restactions}}
                        <tr>
                            <td><span class="badge bg-{{severityclass}}">{{severity}}</span></td>
                            <td>
                                {{#hasactionurl}}<a href="{{actionurl}}">{{action}}</a>{{/hasactionurl}}
                                {{^hasactionurl}}{{action}}{{/hasactionurl}}
                            </td>
                            <td>{{components}}</td>
                        </tr>
                        {{/restactions}}
                    </tbody>
                    {{/hasrestactions}}
                </table>
            </div>
            {{#hasrestactions}}
            <button type="button" class="btn btn-link p-0 mb-3 upgradeguard-disclosure-link d-inline-flex align-items-center gap-1"
                    data-bs-toggle="collapse" data-bs-target="#ug-rest-actions"
                    aria-expanded="false" aria-controls="ug-rest-actions"
                    data-showlabel="{{showallactions}}" data-hidelabel="{{hideactions}}">{{showallactions}}</button>
            {{/hasrestactions}}
            {{/hasoverviewactions}}

            {{#hasunusedplugins}}
            <details class="mb-2">
                <summary>{{#str}}safe_to_remove, tool_upgradeguard{{/str}}</summary>
                <p class="small text-muted mb-1">{{#str}}safe_to_remove_desc, tool_upgradeguard{{/str}}</p>
                <ul class="mb-0">
                    {{#unusedplugins}}
                    <li>{{component}}</li>
                    {{/unusedplugins}}
                </ul>
            </details>
            {{/hasunusedplugins}}

            <h3>{{#str}}sitefindingsheading, tool_upgradeguard{{/str}}</h3>
            {{#hassitefindings}}
            {{> tool_upgradeguard/findings }}
            {{/hassitefindings}}
            {{^hassitefindings}}
            <p class="text-muted mb-2">{{#str}}sitenofindings, tool_upgradeguard{{/str}}</p>
            {{/hassitefindings}}

            <p class="text-muted small mb-2">{{#str}}disclaimer, tool_upgradeguard{{/str}}</p>
            <p class="text-muted small mb-0">{{datasetversion}}</p>

            {{> tool_upgradeguard/startscan }}

            <div class="upgradeguard-actions mt-3">
                {{#canexport}}
                <a class="btn btn-outline-secondary btn-sm" href="{{exportcsvurl}}">{{#str}}exportcsv, tool_upgradeguard{{/str}}</a>
                <a class="btn btn-outline-secondary btn-sm" href="{{exportjsonurl}}">{{#str}}exportjson, tool_upgradeguard{{/str}}</a>
                {{/canexport}}
                <a class="btn btn-outline-secondary btn-sm" href="{{reporturl}}" target="_blank" rel="noopener">{{#str}}printablereport, tool_upgradeguard{{/str}}</a>
            </div>
            {{/hasscan}}
        </div>

        <div class="tab-pane fade" id="ug-pane-plugins" role="tabpanel"
             aria-labelledby="ug-tab-plugins" tabindex="0">
            {{^hasscan}}
            <div class="alert alert-info">{{#str}}scanresultsnone, tool_upgradeguard{{/str}}</div>
            {{/hasscan}}
            {{#hasscan}}
            <p>{{pluginspagetext}}</p>
            <a class="btn btn-outline-secondary btn-sm" href="{{resultsurl}}">{{#str}}viewallplugins, tool_upgradeguard{{/str}}</a>
            {{/hasscan}}
        </div>

        <div class="tab-pane fade" id="ug-pane-environment" role="tabpanel"
             aria-labelledby="ug-tab-environment" tabindex="0">
            {{#hasenvironment}}
            {{> tool_upgradeguard/environment }}
            {{/hasenvironment}}
            {{^hasenvironment}}
            <div class="alert alert-info">{{environmentnone}}</div>
            {{/hasenvironment}}
        </div>

        <div class="tab-pane fade" id="ug-pane-files" role="tabpanel"
             aria-labelledby="ug-tab-files" tabindex="0">
            {{^hasscan}}
            <div class="alert alert-info">{{#str}}scanresultsnone, tool_upgradeguard{{/str}}</div>
            {{/hasscan}}
            {{#hasscan}}
            {{#hasmovelist}}
            {{> tool_upgradeguard/movelist }}
            {{/hasmovelist}}
            {{^hasmovelist}}
            <div class="alert alert-info">{{filenoneeded}}</div>
            {{/hasmovelist}}
            {{/hasscan}}
        </div>

        <div class="tab-pane fade" id="ug-pane-checklist" role="tabpanel"
             aria-labelledby="ug-tab-checklist" tabindex="0">
            {{^hasscan}}
            <div class="alert alert-info">{{#str}}scanresultsnone, tool_upgradeguard{{/str}}</div>
            {{/hasscan}}
            {{#hasscan}}
            {{#haschecklist}}
            {{> tool_upgradeguard/checklist }}
            {{/haschecklist}}
            {{^haschecklist}}
            <div class="alert alert-info">{{checklistnotready}}</div>
            {{/haschecklist}}
            {{/hasscan}}
        </div>

        <div class="tab-pane fade" id="ug-pane-history" role="tabpanel"
             aria-labelledby="ug-tab-history" tabindex="0">
            {{^hasscan}}
            <div class="alert alert-info">{{#str}}scanresultsnone, tool_upgradeguard{{/str}}</div>
            {{/hasscan}}
            {{#hashistory}}
            <h2>{{historyheading}}</h2>
            <div class="table-responsive">
                <table class="table table-sm generaltable">
                    <thead>
                        <tr>
                            <th scope="col">{{#str}}targetversion, tool_upgradeguard{{/str}}</th>
                            <th scope="col">{{#str}}readinessscore, tool_upgradeguard{{/str}}</th>
                            <th scope="col">{{#str}}verdict, tool_upgradeguard{{/str}}</th>
                            <th scope="col">{{#str}}col_datecreated, tool_upgradeguard{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#history}}
                        <tr>
                            <td><a href="{{url}}">{{targetversion}}</a></td>
                            <td>{{#hasscore}}<span class="upgradeguard-score upgradeguard-score-{{verdictclass}}">{{score}}</span>{{/hasscore}}{{^hasscore}}<span class="text-muted">&ndash;</span>{{/hasscore}}</td>
                            <td><span class="badge upgradeguard-verdict upgradeguard-verdict-{{verdictclass}}">{{verdict}}</span></td>
                            <td>{{timecreated}}</td>
                        </tr>
                        {{/history}}
                    </tbody>
                </table>
            </div>
            {{/hashistory}}
            {{#hasscan}}
            <a class="btn btn-outline-secondary btn-sm" href="{{historyurl}}">{{#str}}historyfull, tool_upgradeguard{{/str}}</a>
            {{/hasscan}}
        </div>

    </div>
</div>